<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.psy.business.mapper.ScaleMapper">

    <resultMap id="ScaleResult" type="com.psy.business.domain.Scale">
        <id     property="scaleId"      column="scale_id"/>
        <result property="scaleName"    column="scale_name"/>
        <result property="scaleCode"    column="scale_code"/>
        <result property="description"  column="description"/>
        <result property="optionType"   column="option_type"/>
        <result property="status"       column="status"/>
        <result property="sortNo"       column="sort_no"/>
        <result property="createTime"   column="create_time"/>
        <result property="updateTime"   column="update_time"/>
        <result property="questionCount" column="question_count"/>
    </resultMap>

    <select id="selectScaleList" parameterType="com.psy.business.domain.Scale" resultMap="ScaleResult">
        select ps.*, (select count(1) from psy_question q where q.scale_id = ps.scale_id) as question_count
        from psy_scale ps
        <where>
            <if test="scale.scaleName != null and scale.scaleName != ''">
                AND ps.scale_name like concat('%', #{scale.scaleName}, '%')
            </if>
            <if test="scale.scaleCode != null and scale.scaleCode != ''">
                AND ps.scale_code like concat('%', #{scale.scaleCode}, '%')
            </if>
            <if test="scale.status != null and scale.status != ''">
                AND ps.status = #{scale.status}
            </if>
        </where>
        order by ps.sort_no
    </select>

    <insert id="insertScale" parameterType="com.psy.business.domain.Scale" useGeneratedKeys="true" keyProperty="scaleId">
        insert into psy_scale (scale_name, scale_code, description, option_type, status, sort_no)
        values (#{scaleName}, #{scaleCode}, #{description}, #{optionType}, #{status}, #{sortNo})
    </insert>

    <update id="updateScale" parameterType="com.psy.business.domain.Scale">
        update psy_scale
        <set>
            <if test="scaleName != null">scale_name = #{scaleName},</if>
            <if test="scaleCode != null">scale_code = #{scaleCode},</if>
            <if test="description != null">description = #{description},</if>
            <if test="optionType != null">option_type = #{optionType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortNo != null">sort_no = #{sortNo},</if>
        </set>
        where scale_id = #{scaleId}
    </update>
</mapper>
