<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.psy.business.mapper.TestAnswerMapper">

    <insert id="batchInsert">
        insert into psy_test_answer (record_id, question_id, option_value)
        values
        <foreach collection="list" item="item" separator=",">
            (#{item.recordId}, #{item.questionId}, #{item.optionValue})
        </foreach>
    </insert>
</mapper>
